{
  "name": "tab-state-watcher",
  "version": "1.0.0",
  "private": true,
  "description": "Chrome extension that notifies you when any open tab changes state.",
  "type": "module",
  "scripts": {
    "build": "node scripts/clean.mjs && tsc && node scripts/copy-static.mjs",
    "watch": "tsc --watch",
    "typecheck": "tsc --noEmit",
    "icons": "node scripts/make-icons.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/chrome": "^0.3.7",
    "typescript": "^7.0.2"
  }
}
